
# =============================================================================
# AI DevSecOps Platform — Environment Variables
# Copy this file to .env and replace placeholders with local values.
# NEVER commit .env to GitHub.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=devsecops_db

# --- Database Connection ---
DATABASE_URL=postgresql+asyncpg://devsecops:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/devsecops_db
DATABASE_URL_SYNC=postgresql://devsecops:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/devsecops_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Application Security ---
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost","http://127.0.0.1"]

# --- Runtime ---
ENVIRONMENT=development
DEBUG=true

# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- GitHub Integration ---
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET

# --- Scanner Configuration ---
SCAN_UPLOAD_DIR=/tmp/devsecops_uploads
MAX_UPLOAD_SIZE_BYTES=1073741824

# --- OWASP ZAP ---
ZAP_BASE_URL=http://zap:8080
ALLOW_LOCAL_TARGETS=false

# --- Seed Admin Account ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
